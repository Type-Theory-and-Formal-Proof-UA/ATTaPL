  #rule($Gamma tack triangle.filled.r t : Sigma x:T_1.T_2 quad t "не є парою"$, "TA-Proj1", $Gamma tack triangle.filled.r t.1 : T_1$)
  #rule($Gamma tack triangle.filled.r t : Sigma x:T_1.T_2$, "TA-Proj2", $Gamma tack triangle.filled.r t.2 : [x arrow.r.bar t.1]T_2$)
  #rule($Gamma tack triangle.filled.r t_i : T'_i quad Gamma tack triangle.filled.r T'_1 equiv T_1 quad Gamma tack triangle.filled.r T'_2 equiv [x arrow.r.bar t_1]T_2$, "TA-Pair", $Gamma tack triangle.filled.r (t_1,t_2:Sigma x:T_1.T_2) : Sigma x:T_1.T_2$)
