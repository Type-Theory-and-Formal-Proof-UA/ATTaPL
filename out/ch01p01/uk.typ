  #linebreak()
  #rule($(q "in" { "un", "lin" })$, "E-Pair’", $(S;q chevron.l y,z chevron.r) arrow.r_beta (S, x, q chevron.l y,z chevron.r ; x)$)
  #rule($quad$, "E-PairRC", $(S;"rc" chevron.l y,z chevron.r) arrow.r_beta (S, x, "rc"(1) chevron.l y,z chevron.r ; x)$)
