  Синтаксис
  #linebreak()
  кваліфікатори: $q ::= "lin"$ (лінійний), $"un"$ (необмежений)
  #linebreak()
  булеві: $b ::= "true" divides "false"$
  #linebreak()
  терми: $t ::= x$ (змінна), $q b$ (булеве значення), $"if" t "then" t "else" t$ (умовний вираз),
