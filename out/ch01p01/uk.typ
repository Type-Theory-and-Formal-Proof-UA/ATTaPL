  )
  #rule($(q "in" { "un", "lin" })$, "E-Fun’", $(S;q lambda y:T . t) arrow.r_beta (S, x, q lambda y:T . t ; x)$)
  #rule($quad$, "E-FunRC", $(S;"rc" lambda y:T . t) arrow.r_beta (S, x, "rc"(1) lambda y:T . t ; x)$)
  #rule(
    $S(x_1) = q lambda y:T . t quad (q "in" { "un", "lin", "rc"(1) })$,
