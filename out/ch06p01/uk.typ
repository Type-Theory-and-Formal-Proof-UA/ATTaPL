#rules[
  #set align(left)
  *New syntactic forms* #h(1.5em) $Gamma tack s equiv t : T$ #h(1.5em) *Equivalence*
  #linebreak()
  *terms:* $t ::= $ #h(0.3em) $...$ #h(1em) pair #h(0.4em) $chevron.l t, t chevron.r$
  #rule($Gamma tack s_1 equiv t_1 : T_1 quad Gamma tack s_2 equiv t_2 : T_2$, "Q-Pair", $Gamma tack chevron.l s_1, s_2 chevron.r equiv chevron.l t_1, t_2 chevron.r : T_1 times T_2$)
  #linebreak()
  first projection #h(0.4em) $t.1$ #h(1em) second projection #h(0.4em) $t.2$
  #rule($Gamma tack s equiv t : T_1 times T_2$, "Q-Proj1", $Gamma tack s.1 equiv t.1 : T_1$)
  #rule($Gamma tack s equiv t : T_1 times T_2$, "Q-Proj2", $Gamma tack s.2 equiv t.2 : T_2$)
  #linebreak()
  *types:* $T ::= $ #h(0.3em) $...$ #h(1em) $T_1 times T_2$ #h(0.4em) product type
  #linebreak()
  $Gamma tack t : T$ #h(1.5em) *Typing*
  #rule($Gamma tack t_1 : T_1 quad Gamma tack t_2 : T_2$, "T-Pair", $Gamma tack chevron.l t_1, t_2 chevron.r : T_1 times T_2$)
  #rule($Gamma tack t : T_1 times T_2$, "T-Proj1", $Gamma tack t.1 : T_1$)
  #rule($Gamma tack t : T_1 times T_2$, "T-Proj2", $Gamma tack t.2 : T_2$)
  #rule($Gamma tack s_1 equiv t : T_1 quad Gamma tack s_2 : T_2$, "Q-Beta-Prod1", $Gamma tack chevron.l s_1, s_2 chevron.r . 1 equiv t : T_1$)
  #rule($Gamma tack s_1 : T_1 quad Gamma tack s_2 equiv t : T_2$, "Q-Beta-Prod2", $Gamma tack chevron.l s_1, s_2 chevron.r . 2 equiv t : T_2$)
  #rule($Gamma tack s.1 equiv t.1 : T_1 quad Gamma tack s.2 equiv t.2 : T_2$, "Q-Ext-Prod", $Gamma tack s equiv t : T_1 times T_2$)
]

