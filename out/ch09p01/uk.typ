  #rule($Gamma tack ⋄ quad quad X in.not "dom"(Gamma)$, "CTX-Kind", $Gamma, X :: K tack ⋄$)
  #linebreak()
  #emph[Кіндування:] $Gamma tack T :: K$
  #rule($X :: K in Gamma quad quad Gamma tack ⋄$, "K-Var", $Gamma tack X :: K$)
  #rule($Gamma, X :: K_1 tack T_2 :: K_2$, "K-Abs", $Gamma tack lambda X : K_1 . T_2 :: K_1 => K_2$)
  #rule($Gamma tack T_1 :: K_11 => K_12 quad quad Gamma tack T_2 :: K_11$, "K-App", $Gamma tack T_1 T_2 :: K_12$)
  #rule($Gamma tack T_1 :: * quad quad Gamma tack T_2 :: *$, "K-Arrow", $Gamma tack T_1 arrow.r T_2 :: *$)
  #rule($Gamma tack T_1 :: * quad quad Gamma tack T_2 :: *$, "K-Times", $Gamma tack T_1 times T_2 :: *$)
  #rule($Gamma, X :: K_1 tack T_2 :: *$, "K-All", $Gamma tack forall X :: K_1 . T_2 :: *$)
  #linebreak()
  #emph[Еквівалентність типів:] $Gamma tack S equiv T :: K$
  #rule($Gamma tack T :: K$, "Q-Refl", $Gamma tack T equiv T :: K$)
  #rule($Gamma tack T equiv S :: K$, "Q-Sym", $Gamma tack S equiv T :: K$)
  #rule($Gamma tack S equiv U :: K quad quad Gamma tack U equiv T :: K$, "Q-Trans", $Gamma tack S equiv T :: K$)
  #rule($Gamma tack S_1 equiv T_1 :: * quad quad Gamma tack S_2 equiv T_2 :: *$, "Q-Arrow", $Gamma tack S_1 arrow.r S_2 equiv T_1 arrow.r T_2 :: *$)
  #rule($Gamma tack S_1 equiv T_1 :: * quad quad Gamma tack S_2 equiv T_2 :: *$, "Q-Times", $Gamma tack S_1 times S_2 equiv T_1 times T_2 :: *$)
  #rule($Gamma, X :: K_1 tack S_2 equiv T_2 :: *$, "Q-All", $Gamma tack forall X :: K_1 . S_2 equiv forall X :: K_1 . T_2 :: *$)
  #rule($Gamma, X :: K_1 tack S_2 equiv T_2 :: K_2$, "Q-Abs", $Gamma tack lambda X : K_1 . S_2 equiv lambda X : K_1 . T_2 :: K_1 => K_2$)
