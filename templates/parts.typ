// Титульна сторінка частини (Part I..V) — як у книжці на стор. 16, 152, 236, 306, 402.
//
// Ці сторінки не належать жодному розділу: у manifest.json їх немає, тож до збірки
// вони довго не потрапляли. Книжка друкує на кожній назву частини («P a r t I») і
// її заголовок. Нумерація частин лишається римською, назви — перекладено.
//
// scripts/50_assemble.py викликає #partpage() перед першим розділом кожної частини.
//
// Пастка: `align(center + horizon)` центрує в межах ТЕКУЧОЇ сторінки, тож заголовок
// малюється поверх попередньої сторінки, якщо розрив сторінки не відбувся до нього.
// Тому нумерацію вимикаємо для всієї сторінки через `page(numbering: none)` окремо
// (не як #set у потоці), а сам блок стоїть після явного #pagebreak().
//
// Вертикальне положення взято з книжки: там заголовок частини стоїть не по центру
// сторінки, а ближче до верху (стор. 152: «P a r t I I» на y=125 із 648, назва —
// на y=174).  Тому це фіксований відступ, а не horizon.
#import "/templates/preamble.typ": *

#let partpage(num, title) = context if target() == "html" {
  // HTML: tools/split_html.py ставить це над заголовком наступного розділу.
  html.elem("h2", attrs: (class: "part"))[Частина #num. #title]
} else {
  pagebreak()
  context {
    set page(numbering: none)
    place(top + center, dy: 2.05cm)[
      #text(size: 20pt, tracking: 0.35em)[Частина #num]
      #v(0.62cm)
      #text(size: 18pt)[#title]
    ]
  }
  pagebreak()
}
